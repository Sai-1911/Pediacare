# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/pediacare?retryWrites=true&w=majority

# Port (Cloud providers like Render set this automatically)
PORT=8000

# Secret key for JWT authentication
JWT_SECRET=your_jwt_secret_key_here

# Production Frontend URL (e.g. https://your-pediacare.vercel.app)
FRONTEND_URL=https://your-app.vercel.app

# Gemini API Key (for Chatbot)
GEMINI_API_KEY=your_gemini_api_key
